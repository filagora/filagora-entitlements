{
    "name": "zencart/forumkit-entitlements",
    "description": "Entitlements for ForumKit: definitions, grants, requests, a cached resolver and the authorization service.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "forum"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "zencart/forumkit-core": "dev-master"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ForumKit\\Entitlements\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForumKit\\Entitlements\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ForumKit\\Entitlements\\EntitlementsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zcwilt/forumkit-core"
        }
    ]
}
